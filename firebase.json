{
  "hosting": {
    "site": "beedraw2",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": [
    {
      "instance": "beedraw",
      "rules": "database.rules.json"
    }
  ],
  "storage": [
    {
      "bucket": "beedraw",
      "rules": "storage.rules"
    }
  ]
}
